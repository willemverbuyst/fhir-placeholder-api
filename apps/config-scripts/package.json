{
  "name": "config-scripts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/es/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/es/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "bunchee",
    "type:check": "tsc",
    "config:cleanup": "tsx ./src/cleanup.ts",
    "config:create": "tsx ./src/setupConfig.ts",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests"
  },
  "dependencies": {
    "@repo/dummy-data": "workspace:*"
  }
}
