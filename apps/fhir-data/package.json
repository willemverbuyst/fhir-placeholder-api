{
  "name": "fhir-data",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/es/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/es/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "bunchee",
    "type:check": "tsc",
    "config:cleanup": "tsx ./src/scripts/cleanup.ts",
    "config:seed": "tsx ./src/scripts/setupConfig.ts",
    "data:seed": "tsx ./src/database/main.ts"
  },
  "dependencies": {
    "@repo/dummy-data": "workspace:*",
    "better-sqlite3": "^12.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
