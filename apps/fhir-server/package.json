{
  "name": "fhir-server",
  "version": "0.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "config:cleanup": "tsx scripts/cleanup.ts",
    "config:setup": "tsx scripts/setupConfig.ts",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test:unit": "NODE_ENV=test jest",
    "test:unit:watch": "jest --watch",
    "test:unit:verbose": "jest --verbose --watch",
    "test:unit:cov": "jest --coverage",
    "test:unit:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json",
    "type:check": "tsc"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.15",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.15",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.15",
    "@nestjs/swagger": "^11.2.0",
    "@repo/dummy-data": "workspace:*",
    "@repo/fhir-terminology": "workspace:*",
    "class-sanitizer": "^1.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "remeda": "^2.33.6",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.16.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.15",
    "@types/express": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.module.(t|j)s",
      "!config/**/*.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
