{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["turbo.json"],
      "project": ["**/*.{js,ts,json,php}"],
      "ignore": [
        "overview/assets/overview.js",
        "apps/resource-statuses/tailwind.config.js"
      ],
      "ignoreBinaries": ["python3"]
    },
    "apps/fhir-client": {
      "entry": ["index.html"],
      "project": ["src/**/*.{ts,tsx}", "**/*.config.{js,ts}"],
      "ignore": ["src/components/ui/**"],
      "ignoreDependencies": [
        "tailwindcss",
        "globals",
        "tw-animate-css",
        "@testing-library/jest-dom",
        "@testing-library/react"
      ]
    },
    "apps/fhir-to-tables": {
      "ignoreDependencies": ["postcss"]
    },
    "apps/fhir-server": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts", "!test/**/*.e2e*.ts"],
      "ignoreDependencies": [
        "@types/express",
        "@types/supertest",
        "supertest",
        "source-map-support",
        "ts-loader"
      ]
    },
    "apps/resource-statuses": {
      "ignore": ["tailwind.config.js"]
    },
    "apps/user-management": {
      "ignoreDependencies": ["vue", "vue-router"]
    },
    "packages/dummy-data": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/fhir-terminology": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/utils": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "services/fhir-to-spreadsheet": {
      "entry": ["main.py"],
      "project": ["**/*.py"]
    }
  }
}
