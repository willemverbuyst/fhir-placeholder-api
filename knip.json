{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["turbo.json"],
      "project": ["**/*.{js,ts,json}"]
    },
    "apps/fhir-client": {
      "entry": ["index.html"],
      "project": ["src/**/*.{ts,tsx}", "**/*.config.{js,ts}"],
      "ignore": ["src/components/ui/**"],
      "ignoreDependencies": [
        "tailwindcss",
        "globals",
        "tw-animate-css",
        "@testing-library/jest-dom",
        "@testing-library/react"
      ]
    },
    "apps/fhir-to-tables": {
      "ignoreDependencies": ["postcss"]
    },
    "apps/fhir-server": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts", "!test/**/*.e2e*.ts"],
      "ignoreDependencies": [
        "supertest",
        "@types/supertest",
        "ts-loader",
        "source-map-support"
      ]
    },
    "packages/dummy-data": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/fhir-terminology": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/utils": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "services/fhir-to-spreadsheet": {
      "entry": ["main.py"],
      "project": ["**/*.py"]
    }
  }
}
