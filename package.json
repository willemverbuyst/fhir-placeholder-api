{
  "name": "fhir-placeholder-api",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:select": "python3 cli/monorepo-launcher/launcher.py --manifest cli/monorepo-launcher/targets.json",
    "format:check": "biome format . && prettier --check \"**/*.vue\"",
    "format:fix": "biome format --write . && prettier --write \"**/*.vue\"",
    "knip:check": "knip",
    "lint:check": "biome lint",
    "lint:fix": "biome lint --write .",
    "spell:check": "cspell \"**/*.{ts,tsx,js,jsx,md,json,yml,yaml,sql,html,go}\"",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "type:check": "turbo run type:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/fhir": "^0.0.41",
    "@types/node": "^25.3.3",
    "bunchee": "^6.9.4",
    "cspell": "^9.6.4",
    "husky": "^9.1.7",
    "knip": "^5.88.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "turbo": "^2.8.16",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18",
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  }
}
