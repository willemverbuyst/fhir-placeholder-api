{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format:check": {},
    "lint:check": {},
    "test:unit": { "dependsOn": ["^build"] },
    "test:e2e": { "dependsOn": ["^build"] },
    "type:check": { "dependsOn": ["^build"] }
  }
}
